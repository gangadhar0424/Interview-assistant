# Production environment for docker-compose.prod.yml (M-12). COPY to infra/deploy/production.env,
# fill every CHANGE_ME from your secret manager, and keep that file OUT of version control (it is
# git-ignored by the `.env.*` rule only if it is named .env.something; name it production.env and
# verify with `git check-ignore -v infra/deploy/production.env` before the first commit).
# Nothing in this file is a real credential.

APP_ENV=production
LOG_LEVEL=INFO
API_IMAGE=interview-assistant-api:CHANGE_ME_TAG

# --- PostgreSQL. Two identities: the schema owner runs migrations; a separate non-superuser,
# non-owner login that can SET ROLE interview_app_runtime serves requests (docs/OPERATIONS.md).
POSTGRES_USER=CHANGE_ME_owner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=interview_assistant
MIGRATION_DATABASE_URL=postgresql+asyncpg://CHANGE_ME_owner:CHANGE_ME@postgres:5432/interview_assistant
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_runtime:CHANGE_ME@postgres:5432/interview_assistant
# SEC-12: used ONLY by the opt-in `maintenance` service (docker compose --profile ops run ...);
# it is not passed to the API, worker, web or migrate containers. Leave it out of any shared file.
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://CHANGE_ME_maintenance:CHANGE_ME@postgres:5432/interview_assistant

# --- Redis over TLS. REDIS_TLS_DIR holds redis.crt, redis.key, ca.crt for the Redis container;
# REDIS_CA_FILE is ONLY the public CA certificate (mounted into the API and worker).
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=rediss://:CHANGE_ME@redis:6379/0?ssl_ca_certs=/run/tls/ca.crt
REDIS_TLS_DIR=/srv/interview-assistant/redis-tls
REDIS_CA_FILE=/srv/interview-assistant/redis-tls/ca.crt

# --- Application secrets and policy ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
CORS_ORIGINS=https://CHANGE_ME.example.com
# Signup is closed unless a code of at least 16 random characters is set.
SIGNUP_INVITE_CODE=
TRUSTED_PROXY_ENABLED=true
TRUSTED_PROXY_HOPS=1

# --- Providers (server-side only). The fake providers are refused outside APP_ENV=local, and
# EMBEDDING_PROVIDER=fastembed needs the optional extra and a ~2 GB model (docs/DEPLOYMENT.md).
EMBEDDING_PROVIDER=fastembed
LLM_ENABLED_PROVIDERS=CHANGE_ME
STT_ENABLED_PROVIDERS=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# --- Sizing (defaults shown) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
API_PORT=8000
API_MEM_LIMIT=1g
API_CPUS=1.5
WORKER_MEM_LIMIT=2g
WORKER_CPUS=2.0
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=2.0
REDIS_MEM_LIMIT=512m

# --- Optional hardening (docs/DEPLOYMENT.md section 12) ---
# Require a bearer token on /metrics (24+ characters). Keep the proxy rule that hides /metrics as well.
METRICS_BEARER_TOKEN=
# Refuse handoff codes that are not bound to a desktop-held secret (SEC-08). The web app and the desktop
# app both bind them now, so this is on. Set false ONLY to support a desktop build older than that.
HANDOFF_REQUIRE_CHALLENGE=true
