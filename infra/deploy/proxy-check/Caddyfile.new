{
	auto_https off
	admin off
}
:80 {
	# NEW layout (infra/deploy/Caddyfile.example): /api/* straight to the API, the rest to the web app.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
