# Local development only. Replace every placeholder before exposing services outside localhost.
APP_ENV=local
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=interview_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://interview:change-me-local-only@localhost:5432/interview_assistant
# Optional locally. In staging/production set this to a separate maintenance identity.
MAINTENANCE_DATABASE_URL=
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Set to `python -c "import secrets; print(secrets.token_urlsafe(32))"` output.
JWT_SECRET=replace-with-a-random-token-from-python-secrets
CORS_ORIGINS=http://localhost:3000
FILE_STORAGE_ROOT=./app-data

# AI provider is disabled by default; keep credentials server-side.
LLM_ENABLED_PROVIDERS=
# Screenshot input (Phase 11A, D-51): a separate vision allow-list, empty = disabled. Only the
# deterministic `fake` provider exists (APP_ENV=local); no real vision provider is integrated.
VISION_ENABLED_PROVIDERS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# --- Auth abuse protection (Phase 13A Batch 2). All limits are per API process. ---
# Outside APP_ENV=local signup is CLOSED unless an invite code (>= 16 characters) is set here;
# in local development an empty value means open signup. Never commit a real code.
SIGNUP_INVITE_CODE=
LOGIN_FAILURES_PER_EMAIL=5
LOGIN_FAILURES_PER_CLIENT=20
LOGIN_WINDOW_SECONDS=900
SIGNUP_ATTEMPTS_PER_CLIENT_PER_HOUR=10
SIGNUP_FAILURES_GLOBAL_PER_HOUR=30
# Read X-Forwarded-For only when true, and run uvicorn with --no-proxy-headers. HOPS = number of
# trusted proxies that append to the header (one reverse proxy = 1).
TRUSTED_PROXY_ENABLED=false
TRUSTED_PROXY_HOPS=1

# --- Web -> desktop handoff (Phase 13 handoff, D-55) ---
# Optional. Absolute https URL of the Windows installer, shown in the "desktop app did not open"
# guidance. Unset = the page tells users to ask their administrator. Never put credentials in it.
# Inlined at web build time (rebuild after changing).
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
