# Local development only. Replace every placeholder before exposing services outside localhost.
APP_ENV=local
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=interview_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://interview:change-me-local-only@localhost:5432/interview_assistant
# Optional locally. In staging/production set this to a separate maintenance identity.
MAINTENANCE_DATABASE_URL=
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Set to `python -c "import secrets; print(secrets.token_urlsafe(32))"` output.
JWT_SECRET=replace-with-a-random-token-from-python-secrets
CORS_ORIGINS=http://localhost:3000
FILE_STORAGE_ROOT=./app-data
# Where uploaded files live (D-88): `local` (FILE_STORAGE_ROOT above) or `supabase` (a PRIVATE
# Supabase Storage bucket). Copy existing files first: `python -m app.storage.migrate_to_supabase
# --apply` (from services/api), then switch. The secret key is SERVER ONLY (never NEXT_PUBLIC_*).
FILE_STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
# Per-user upload quotas (SEC-15). Defaults are engineering assumptions awaiting owner confirmation.
# Over a limit the API answers 409 file_quota_exceeded / storage_quota_exceeded.
# USER_MAX_RESUMES=20
# USER_MAX_DOCUMENTS=100
# USER_MAX_STORAGE_MB=500

# AI provider is disabled by default; keep credentials server-side.
LLM_ENABLED_PROVIDERS=
# Screenshot input (Phase 11A, D-51): a separate vision allow-list, empty = disabled. Only the
# deterministic `fake` provider exists (APP_ENV=local); no real vision provider is integrated.
VISION_ENABLED_PROVIDERS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# --- Real answers: an OpenAI-compatible LLM (D-33/D-44). Keys are server-side only, never in the
# web app or the desktop app, and never committed. ---
# Option 1, OpenAI:      OPENAI_API_KEY=<your key>, LLM_ENABLED_PROVIDERS=openai
# Option 2, Ollama Cloud: OPENAI_BASE_URL=https://ollama.com/v1, OPENAI_MODEL=<model>,
#                         OLLAMA_API_KEY=<your key>, LLM_ENABLED_PROVIDERS=openai
# No key yet (APP_ENV=local only): LLM_ENABLED_PROVIDERS=fake. The fake provider only ECHOES the
# prompt, it does not answer. Restart the API after changing any of these.
OLLAMA_API_KEY=
# Optional ordered fallback list; may only name providers enabled above.
LLM_FALLBACK_CHAIN=
# Seconds the provider has to produce its first token before the router fails over (default 4).
# LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4

# --- Provider selection (D-57). Each session picks ONE reasoning and ONE voice provider and the
# choice is exclusive (no silent fallback). Keys are server-side only; one model per provider. ---
# Reasoning providers: LLM_ENABLED_PROVIDERS=openai,groq,anthropic,gemini (above). Add the keys you use:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Google Gemini (D-58), reasoning and voice (same key). Add `gemini` to LLM_ENABLED_PROVIDERS and/or STT_ENABLED_PROVIDERS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Voice listening (speech-to-text), a separate allow-list. Empty = audio transcription disabled.
# Options: openai, groq, sarvam, gemini (and `fake` with APP_ENV=local: canned text, not what was said).
STT_ENABLED_PROVIDERS=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
GROQ_STT_MODEL=whisper-large-v3-turbo
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
GEMINI_STT_MODEL=gemini-3.1-flash-lite

# --- Database connection hardening (M-12). Per process: size against Postgres max_connections
# (processes x (DB_POOL_SIZE + DB_MAX_OVERFLOW)). Waiting for a connection is bounded, so exhaustion
# is a fast 503, not a hang. The timeouts are applied by Postgres to every connection. ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# /docs, /redoc and /openapi.json are served only with APP_ENV=local, whatever this says.
API_DOCS_ENABLED=true

# --- Auth abuse protection (Phase 13A Batch 2). All limits are per API process. ---
# Outside APP_ENV=local signup is CLOSED unless an invite code (>= 16 characters) is set here;
# in local development an empty value means open signup. Never commit a real code.
SIGNUP_INVITE_CODE=
LOGIN_FAILURES_PER_EMAIL=5
LOGIN_FAILURES_PER_CLIENT=20
LOGIN_WINDOW_SECONDS=900
SIGNUP_ATTEMPTS_PER_CLIENT_PER_HOUR=10
SIGNUP_FAILURES_GLOBAL_PER_HOUR=30
# Read X-Forwarded-For only when true, and run uvicorn with --no-proxy-headers. HOPS = number of
# trusted proxies that append to the header (one reverse proxy = 1).
TRUSTED_PROXY_ENABLED=false
TRUSTED_PROXY_HOPS=1

# --- Web -> desktop handoff (Phase 13 handoff, D-55) ---
# Optional. Absolute https URL of the Windows installer, shown in the "desktop app did not open"
# guidance. Unset = the page tells users to ask their administrator. Never put credentials in it.
# Inlined at web build time (rebuild after changing).
# Development (D-86): the always-latest UNSIGNED build auto-published on every desktop change, e.g.
# https://github.com/gangadhar0424/Interview-assistant/releases/download/dev-latest/InterviewAssistant-Setup.exe
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=

# --- Answer pipeline (D-66). All default to the previous behaviour; restart the API after changing. ---
# Real embeddings (needs about 2.2 GB download and 2 GB RAM). Without this the FAKE hash embedder is
# used (local development only): keyword search still works, meaning-based search does not.
# After enabling it run:  uv run python -m app.workers.reindex   and re-check scripts/eval_retrieval.py
# EMBEDDING_PROVIDER=fastembed
# dense (previous) or hybrid (meaning + keywords, section aware)
QA_RETRIEVAL_MODE=dense
# off (previous), shadow (decide and log, answer the old way) or on (exact text / validated general)
QA_ROUTER_MODE=off
# Check general-knowledge answers (rules + a fast judge model) before showing them
QA_VALIDATE_GENERAL=off
# More passages per question for a larger document set (defaults 8 and 6000)
# QA_RETRIEVAL_TOP_K=12
# QA_CONTEXT_MAX_CHARS=9000
# QA_ANSWER_CACHE_TTL_SECONDS=300
# Default answer detail when a question does not choose one: full or summary (short spoken answer)
# QA_DEFAULT_DETAIL=full

# --- Security options (docs/DEPLOYMENT.md section 12) ---
# APP_ENV=local is refused when the database, Redis or CORS origins are not on this machine. Only for a
# development setup that deliberately uses a remote database; never in a deployment.
# LOCAL_ALLOW_REMOTE_SERVICES=false
# Require a bearer token (24+ characters) on /metrics.
# METRICS_BEARER_TOKEN=
# Refuse handoff codes not bound to a desktop-held secret (leave false until the clients send one).
# HANDOFF_REQUIRE_CHALLENGE=false
