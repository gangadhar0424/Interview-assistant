# Local development only. Replace every placeholder before exposing services outside localhost.
APP_ENV=local
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=interview_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://interview:change-me-local-only@localhost:5432/interview_assistant
# Optional locally. In staging/production set this to a separate maintenance identity.
MAINTENANCE_DATABASE_URL=
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Set to `python -c "import secrets; print(secrets.token_urlsafe(32))"` output.
JWT_SECRET=replace-with-a-random-token-from-python-secrets
CORS_ORIGINS=http://localhost:3000
FILE_STORAGE_ROOT=./app-data

# AI provider is disabled by default; keep credentials server-side.
LLM_ENABLED_PROVIDERS=
# Screenshot input (Phase 11A, D-51): a separate vision allow-list, empty = disabled. Only the
# deterministic `fake` provider exists (APP_ENV=local); no real vision provider is integrated.
VISION_ENABLED_PROVIDERS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
