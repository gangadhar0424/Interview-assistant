# Copy to .env and adjust. ALL VALUES BELOW ARE FAKE DEV PLACEHOLDERS.
# Never commit .env. Real secrets belong in a secret manager (see docs/ARCHITECTURE.md section 13).

# ---- Shared by docker-compose and the API ----
# Postgres container credentials (dev only).
POSTGRES_USER=ia_dev
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=interview_assistant
# Host ports (change if they clash with local services).
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- API service (services/api) ----
# local | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Async SQLAlchemy URL (driver must be postgresql+asyncpg).
# Keep the credentials in sync with POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://ia_dev:change-me-dev-only@localhost:5432/interview_assistant
REDIS_URL=redis://localhost:6379/0

# ---- Authentication (Phase 2) ----
# HMAC secret used to sign access tokens. REQUIRED, at least 32 characters.
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Values starting with "change-me" are rejected when APP_ENV is not "local".
JWT_SECRET=change-me-dev-only-generate-a-real-secret-for-staging-and-prod
# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated explicit browser origins allowed for CORS and for refresh/logout requests.
CORS_ORIGINS=http://localhost:3000

# ---- File storage (Phase 3, docs/DECISIONS.md D-26) ----
# Root directory for uploaded files. Optional in local development (defaults to <repo>/app-data,
# which is git-ignored). REQUIRED in staging/production as an ABSOLUTE path (empty or relative
# values are rejected at startup), where it MUST be a persistent volume that survives
# redeployments and is shared by the API and any workers.
# FILE_STORAGE_ROOT=/app-data
# Upload size limits in MiB (resumes: PDF/DOCX; documents: PDF/DOCX/TXT).
RESUME_MAX_UPLOAD_MB=10
DOCUMENT_MAX_UPLOAD_MB=20

# ---- Ingestion worker (Phase 4) ----
# Claims allowed per job before a stuck job is failed instead of re-queued.
INGESTION_MAX_ATTEMPTS=3
# A `processing` job locked longer than this (seconds) is treated as stuck (crashed worker).
INGESTION_PROCESSING_TIMEOUT_SECONDS=900
# A `pending` job older than this (seconds) is re-sent to the queue by the recovery sweep.
INGESTION_PENDING_REDISPATCH_SECONDS=120

# ---- Embeddings, chunking, retrieval (Phase 5, docs/DECISIONS.md D-30/D-31) ----
# fake | fastembed. Leave unset for local development/tests (deterministic fake vectors with
# no real semantics). REQUIRED (fastembed) in staging/production. fastembed needs the
# optional extra on the worker host:  uv sync --extra embeddings
# EMBEDDING_PROVIDER=fastembed
# Must produce 1024-dimensional vectors (the pgvector column width).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Where fastembed caches the ~2.2 GB model download (persist it on the worker host).
# EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=16
# Chunk size/overlap in characters (overlap must be at most half of the size).
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=100
# Upper bound for chunks returned by one retrieval call.
RETRIEVAL_MAX_LIMIT=20

# ---- LLM provider layer (Phase 6, docs/DECISIONS.md D-33) ----
# Comma-separated provider ids to enable. Only `fake` exists (local development/tests; rejected
# outside APP_ENV=local). Real adapters are not built until OQ-4 is resolved; real provider API
# keys will be server-side env vars only and must never be exposed to the browser.
# LLM_ENABLED_PROVIDERS=fake
# Fallback order (subset of the enabled providers); empty = enabled order.
# LLM_FALLBACK_CHAIN=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4
LLM_STREAM_IDLE_TIMEOUT_SECONDS=15
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=30

# ---- Answer preferences (Phase 7A, docs/DECISIONS.md D-34) ----
# Word targets per answer length (each band must not overlap the next).
ANSWER_SHORT_MIN_WORDS=60
ANSWER_SHORT_MAX_WORDS=90
ANSWER_BALANCED_MIN_WORDS=120
ANSWER_BALANCED_MAX_WORDS=180
ANSWER_LONG_MIN_WORDS=250
ANSWER_LONG_MAX_WORDS=350
# max_output_tokens = max words x tokens-per-word (x the multiplier for Hindi/Telugu).
ANSWER_TOKENS_PER_WORD=2.0
ANSWER_INDIC_TOKEN_MULTIPLIER=2.5
# Maximum length of a session's free-text extra instructions (rejected, not truncated).
EXTRA_INSTRUCTIONS_MAX_CHARS=1000

# ---- Sessions (Phase 7B, docs/DECISIONS.md D-35) ----
# Maximum job description length (characters, after cleaning) and documents per session.
SESSION_JOB_DESCRIPTION_MAX_CHARS=20000
SESSION_MAX_DOCUMENTS=10

# ---- Job import (Phase 7C, docs/DECISIONS.md D-36) ----
# Total time budget for one import (DNS + connect + download), response size cap in bytes, and the
# number of redirects followed (every hop is re-validated against the SSRF policy).
JOB_IMPORT_TIMEOUT_SECONDS=8
JOB_IMPORT_MAX_BYTES=1048576
JOB_IMPORT_MAX_REDIRECTS=3
# Per-user attempts per minute and concurrent imports per API process (in-memory limits).
JOB_IMPORT_RATE_LIMIT_PER_MINUTE=10
JOB_IMPORT_MAX_CONCURRENT=4

# ---- Typed Q&A context assembly (Phase 8A, docs/DECISIONS.md D-38) ----
# Prompt passages: at most TOP_K chunks, of which the best RESUME_QUOTA come from the session's
# resume, within a character budget. History = the last HISTORY_PAIRS answered pairs of the session.
QA_RETRIEVAL_TOP_K=8
QA_RESUME_QUOTA=3
QA_CONTEXT_MAX_CHARS=6000
QA_HISTORY_PAIRS=3
QA_HISTORY_ITEM_MAX_CHARS=1000

# ---- Typed Q&A API protection (Phase 8B, docs/DECISIONS.md D-39) ----
# Per-user question requests per minute and simultaneous generations (in-process limits).
QA_RATE_LIMIT_PER_MINUTE=20
QA_MAX_CONCURRENT_GENERATIONS=2
# Total time budget of one generation; a `streaming` answer older than this is read as `error`.
QA_REQUEST_TIMEOUT_SECONDS=120

# ---- Web app (apps/web) ----
# Server-side URL the Next.js server proxies /api/* to (the browser only talks to the web origin,
# so the refresh cookie stays same-origin). Not exposed to the browser.
API_INTERNAL_URL=http://localhost:8000

# ---- WebSocket gateway (Phase 9A, docs/DECISIONS.md D-41). All optional; values are the defaults. ----
# Single-use ticket lifetime (seconds) and ticket requests per user per minute.
WS_TICKET_TTL_SECONDS=30
WS_TICKET_RATE_LIMIT_PER_MINUTE=30
# The client pings about every heartbeat interval; silence for the idle timeout closes the socket;
# the first message (client.hello) must arrive within the hello timeout. Idle must exceed heartbeat.
WS_HEARTBEAT_INTERVAL_SECONDS=20
WS_IDLE_TIMEOUT_SECONDS=45
WS_HELLO_TIMEOUT_SECONDS=10
# Largest text frame (bytes) and messages per second per connection.
WS_MAX_FRAME_BYTES=16384
WS_MAX_MESSAGES_PER_SECOND=10
# Connection caps per user and per API process (per process, see docs R-46).
WS_MAX_CONNECTIONS_PER_USER=3
WS_MAX_TOTAL_CONNECTIONS=200
# Phase 9B backpressure: messages queued per socket, and the longest one write may take (seconds).
# A client that exceeds either is closed with code 4010 (slow consumer).
WS_SEND_QUEUE_EVENTS=1000
WS_SEND_TIMEOUT_SECONDS=10
# Phase 9C: a generation keeps running this long after its socket drops (seconds), and a channel
# retains this many sequenced events for resume_from_seq replay.
WS_RESUME_GRACE_SECONDS=30
WS_RESUME_BUFFER_EVENTS=2000
